<% content_for :title, "Your recipes" %>

<main class="page">
  <%= link_to root_path, class: "back-link" do %>
    <%= icon(:arrow_left) %> New search
  <% end %>

  <h1 class="page-title mt-3 mb-3">Recipes from what you have</h1>
  <div class="chip-list mb-5" aria-label="Your ingredients">
    <% @chat.ingredients_input.to_s.split(/[,\n]/).map(&:strip).compact_blank.each do |item| %>
      <span class="chip"><%= item %></span>
    <% end %>
  </div>

  <%# Follow-up requests the user has made in this chat %>
  <%= render partial: "messages/message", collection: @follow_ups, as: :message %>

  <% if @recipes.any? %>
    <div class="stack">
      <% @recipes.each do |recipe| %>
        <%= render "recipes/recipe", recipe: recipe, saved: @saved_recipe_ids.include?(recipe.id) %>
      <% end %>
    </div>
  <% else %>
    <p class="text-body-secondary">No recipes yet.</p>
  <% end %>

  <%= render "messages/form", chat: @chat %>
</main>
