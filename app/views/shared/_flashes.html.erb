<% if flash.any? %>
  <div class="flashes">
    <% flash.each do |type, message| %>
      <% notice = type.to_s == "notice" %>
      <div class="flash flash--<%= notice ? "notice" : "alert" %>" role="<%= notice ? "status" : "alert" %>">
        <%= icon(notice ? :check : :alert) %>
        <span><%= message %></span>
      </div>
    <% end %>
  </div>
<% end %>
