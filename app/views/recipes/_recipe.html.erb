<%# locals: recipe, saved (boolean) %>
<% missing = recipe.missing_ingredients.size %>

<article class="card recipe-card card-hover">
  <div class="recipe-card__header">
    <h2 class="recipe-card__title">
      <%= link_to recipe.title, recipe_path(recipe) %>
    </h2>
    <%= render "saved_recipes/toggle", recipe: recipe, saved: saved %>
  </div>

  <p class="recipe-card__description"><%= recipe.description %></p>

  <div class="meta-list mt-1">
    <% if recipe.total_minutes.positive? %>
      <span><%= icon(:clock) %><%= recipe.total_minutes %> min</span>
    <% end %>
    <% if recipe.servings.present? %>
      <span><%= icon(:users) %>Serves <%= recipe.servings %></span>
    <% end %>
    <% if recipe.calories.present? %>
      <span><%= icon(:flame) %>~<%= recipe.calories %> kcal / serving</span>
    <% end %>
    <% if missing.zero? %>
      <span class="pill pill--success">You have everything</span>
    <% else %>
      <span class="pill pill--need">Need <%= pluralize(missing, "more ingredient") %></span>
    <% end %>
  </div>
</article>
