<%# locals: saved_recipe %>
<% recipe = saved_recipe.recipe %>

<div class="card mb-3" id="<%= dom_id(saved_recipe) %>">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-start gap-3">
      <div>
        <h5 class="card-title mb-1">
          <%= link_to recipe.title, recipe_path(recipe), class: "text-decoration-none" %>
        </h5>
        <% if saved_recipe.rating.present? %>
          <div class="text-warning" aria-label="Rated <%= saved_recipe.rating %> out of 5">
            <%= stars(saved_recipe.rating) %>
          </div>
        <% end %>
      </div>

      <%= button_to "Remove", recipe_saved_recipe_path(recipe),
            method: :delete,
            class: "btn btn-sm btn-outline-danger",
            form: { data: { turbo_confirm: "Remove this recipe from your saved list? Your notes and rating will be deleted too." } } %>
    </div>

    <p class="card-text text-muted mb-2"><%= recipe.description %></p>

    <div class="small text-muted d-flex flex-wrap gap-3">
      <% if recipe.total_minutes.positive? %>
        <span>⏱ <%= recipe.total_minutes %> min</span>
      <% end %>
      <% if recipe.servings.present? %>
        <span>🍽 Serves <%= recipe.servings %></span>
      <% end %>
      <% if recipe.calories.present? %>
        <span>🔥 ~<%= recipe.calories %> kcal / serving</span>
      <% end %>
      <span>Saved <%= time_ago_in_words(saved_recipe.created_at) %> ago</span>
    </div>

    <% if saved_recipe.notes.present? %>
      <div class="mt-3 p-2 bg-light rounded small">
        <%= simple_format(saved_recipe.notes, {}, wrapper_tag: "div") %>
      </div>
    <% end %>

    <details class="mt-3">
      <summary class="small text-primary" style="cursor: pointer;">
        <%= saved_recipe.notes.present? || saved_recipe.rating.present? ? "Edit notes & rating" : "Add notes & rating" %>
      </summary>

      <%= form_with model: saved_recipe, class: "mt-2" do |f| %>
        <div class="mb-2">
          <%= f.label :rating, "Rating", class: "form-label small" %>
          <%= f.select :rating, rating_options, { include_blank: "No rating" },
                class: "form-select form-select-sm w-auto" %>
        </div>

        <div class="mb-2">
          <%= f.label :notes, "Notes", class: "form-label small" %>
          <%= f.text_area :notes, rows: 3, class: "form-control",
                placeholder: "Used less salt, great with rice..." %>
        </div>

        <%= f.submit "Save", class: "btn btn-sm btn-primary" %>
      <% end %>
    </details>
  </div>
</div>
