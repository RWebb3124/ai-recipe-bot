<%# locals: saved_recipe %>
<% recipe = saved_recipe.recipe %>

<article class="card recipe-card" id="<%= dom_id(saved_recipe) %>">
  <div class="recipe-card__header">
    <div class="d-flex flex-column gap-1" style="min-width: 0;">
      <h2 class="recipe-card__title">
        <%= link_to recipe.title, recipe_path(recipe) %>
      </h2>
      <% if saved_recipe.rating.present? %>
        <div class="stars" role="img" aria-label="Rated <%= saved_recipe.rating %> out of 5">
          <%= stars(saved_recipe.rating) %>
        </div>
      <% end %>
    </div>

    <%= button_to "Remove", recipe_saved_recipe_path(recipe),
          method: :delete,
          class: "btn btn-pill btn-danger-outline",
          form: { data: { turbo_confirm: "Remove this recipe from your saved list? Your notes and rating will be deleted too." } } %>
  </div>

  <p class="recipe-card__description"><%= recipe.description %></p>

  <div class="meta-list">
    <% if recipe.total_minutes.positive? %>
      <span><%= icon(:clock) %><%= recipe.total_minutes %> min</span>
    <% end %>
    <% if recipe.servings.present? %>
      <span><%= icon(:users) %>Serves <%= recipe.servings %></span>
    <% end %>
    <% if recipe.calories.present? %>
      <span><%= icon(:flame) %>~<%= recipe.calories %> kcal / serving</span>
    <% end %>
    <span>Saved <%= time_ago_in_words(saved_recipe.created_at) %> ago</span>
  </div>

  <% if saved_recipe.notes.present? %>
    <div class="note-box mt-1">
      <%= icon(:pencil) %>
      <%= simple_format(saved_recipe.notes, {}, wrapper_tag: "div") %>
    </div>
  <% end %>

  <details class="saved-edit">
    <summary class="btn-text">
      <%= icon(:chevron_right, size: 14, stroke_width: 2.4) %>
      <%= saved_recipe.notes.present? || saved_recipe.rating.present? ? "Edit notes & rating" : "Add notes & rating" %>
    </summary>

    <%= form_with model: saved_recipe, class: "saved-edit__form" do |f| %>
      <div>
        <%= f.label :rating, "Rating", class: "form-label form-label--sm" %>
        <%= f.select :rating, rating_options, { include_blank: "No rating" },
              class: "form-select w-auto" %>
      </div>

      <div>
        <%= f.label :notes, "Notes", class: "form-label form-label--sm" %>
        <%= f.text_area :notes, rows: 3, class: "form-control",
              placeholder: "Used less salt, great with rice..." %>
      </div>

      <div>
        <%= f.submit "Save", class: "btn btn-primary" %>
      </div>
    <% end %>
  </details>
</article>
