<% content_for :title, "Saved recipes" %>

<main class="page">
  <h1 class="page-title">My saved recipes</h1>
  <p class="page-subtitle"><%= pluralize(@saved_recipes.size, "recipe") %> saved</p>

  <% if @saved_recipes.any? %>
    <div class="stack">
      <%= render partial: "saved_recipes/saved_recipe",
                 collection: @saved_recipes, as: :saved_recipe %>
    </div>
  <% else %>
    <div class="empty-state">
      <span class="empty-state__icon empty-state__icon--plum"><%= icon(:bookmark, size: 24) %></span>
      <h2>No saved recipes yet</h2>
      <p>You haven't saved any recipes yet. <%= link_to "Find something to cook", root_path %>.</p>
    </div>
  <% end %>
</main>
