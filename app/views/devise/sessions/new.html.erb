<% content_for :title, "Log in" %>

<div>
  <h1>Welcome back</h1>
  <p class="text-body-secondary mb-0">Log in to see your saved recipes and pantry.</p>
</div>

<%= form_for(resource, as: resource_name, url: session_path(resource_name),
      html: { class: "auth__form", data: { controller: "password-visibility" } }) do |f| %>
  <div>
    <%= f.label :email, class: "form-label form-label--sm" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control",
          placeholder: "you@example.com" %>
  </div>

  <div>
    <div class="label-row">
      <%= f.label :password, class: "form-label form-label--sm" %>
      <% if devise_mapping.recoverable? %>
        <%= link_to "Forgot your password?", new_password_path(resource_name), class: "small" %>
      <% end %>
    </div>
    <%= render "devise/shared/password_field", f: f, field: :password, autocomplete: "current-password" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="form-check">
      <%= f.check_box :remember_me, class: "form-check-input" %>
      <%= f.label :remember_me, class: "form-check-label" %>
    </div>
  <% end %>

  <%= f.submit "Log in", class: "btn btn-primary" %>
<% end %>

<% if devise_mapping.registerable? %>
  <p class="auth__switch">New to Recipe Helper? <%= link_to "Create an account", new_registration_path(resource_name) %></p>
<% end %>
<%= render "devise/shared/links" %>
