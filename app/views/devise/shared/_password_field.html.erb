<%# locals: f, field, autocomplete, describedby (optional), autofocus (optional) %>
<div class="password-field">
  <%= f.password_field field, autocomplete: autocomplete, autofocus: local_assigns[:autofocus],
        class: ["form-control", ("is-invalid" if f.object.errors[field].any?)],
        aria: { describedby: local_assigns[:describedby] },
        data: { password_visibility_target: "input" } %>
  <button type="button" class="password-field__toggle" aria-label="Show password" aria-pressed="false"
          data-action="password-visibility#toggle" data-password-visibility-target="button">
    <%= icon(:eye, size: 18) %>
  </button>
</div>
