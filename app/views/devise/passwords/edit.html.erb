<% content_for :title, "Change your password" %>

<div>
  <h1>Change your password</h1>
  <p class="text-body-secondary mb-0">Choose a new password for your account.</p>
</div>

<%= form_for(resource, as: resource_name, url: password_path(resource_name),
      html: { method: :put, class: "auth__form", data: { controller: "password-visibility" } }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <div>
    <%= f.label :password, "New password", class: "form-label form-label--sm" %>
    <%= render "devise/shared/password_field", f: f, field: :password, autocomplete: "new-password", autofocus: true,
          describedby: ("password-hint" if @minimum_password_length) %>
    <% if @minimum_password_length %>
      <div id="password-hint" class="form-text"><%= @minimum_password_length %> characters minimum</div>
    <% end %>
  </div>

  <div>
    <%= f.label :password_confirmation, "Confirm new password", class: "form-label form-label--sm" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password",
          class: ["form-control", ("is-invalid" if resource.errors[:password_confirmation].any?)],
          data: { password_visibility_target: "input" } %>
  </div>

  <%= f.submit "Change my password", class: "btn btn-primary" %>
<% end %>

<p class="auth__switch"><%= link_to "Back to log in", new_session_path(resource_name) %></p>
<%= render "devise/shared/links" %>
